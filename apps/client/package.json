{
	"name": "@silk-road-monopoly/client",
	"author": "Fat_Paper",
	"description": "Silk Road Monopoly 游戏客户端 - 海上丝绸之路",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"main": "dist-electron/main.js",
	"scripts": {
		"dev": "vite --host",
		"build": "vite build && electron-builder",
		"build:electron": "vite build && electron-builder",
		"build:web": "vite build --mode web",
		"build:capacitor": "vite build --mode capacitor",
		"dev:capacitor": "vite --host 0.0.0.0",
		"cap:sync": "npx cap sync",
		"cap:copy": "npx cap copy",
		"cap:open": "npx cap open android",
		"cap:android": "npm run build:capacitor && npx cap copy && npx cap sync",
		"cap:dev": "npx cap copy && npx cap sync && npm run dev:capacitor",
		"check": "vue-tsc --noEmit",
		"electron": "electron .",
		"preview": "vite preview"
	},
	"dependencies": {
		"@capacitor/core": "^8.4.0",
		"@capacitor/status-bar": "^8.0.2",
		"electron-log": "^5.4.3",
		"electron-updater": "^6.6.2",
		"gsap": "^3.12.7",
		"three": "0.179.1"
	},
	"devDependencies": {
		"@silk-road-monopoly/env": "workspace:*",
		"@silk-road-monopoly/types": "workspace:*",
		"@silk-road-monopoly/ui": "workspace:*",
		"@silk-road-monopoly/utils": "workspace:*",
		"@types/howler": "^2.2.12",
		"@types/three": "0.179.0",
		"cannon-es": "^0.20.0",
		"electron": "37.2.6",
		"electron-builder": "26.0.12",
		"eventemitter3": "^5.0.0",
		"howler": "^2.2.4",
		"html-to-image": "^1.11.11",
		"marked": "^18.0.3",
		"peerjs": "^1.5.4",
		"vue-advanced-cropper": "^2.8.9"
	}
}
