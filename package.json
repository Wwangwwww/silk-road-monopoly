{
  "name": "@silk-road-monopoly/root",
  "version": "1.0.0",
  "description": "A Maritime Silk Road themed multiplayer online Monopoly game with custom map editor | 海上丝绸之路主题的多人在线大富翁游戏",
  "main": "index.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wwangwwww/silk-road-monopoly.git"
  },
  "homepage": "https://github.com/Wwangwwww/silk-road-monopoly#readme",
  "bugs": {
    "url": "https://github.com/Wwangwwww/silk-road-monopoly/issues"
  },
  "scripts": {
    "dev-client": "pnpm --filter @silk-road-monopoly/client run dev",
    "dev-server": "pnpm --filter @silk-road-monopoly/server run dev",
    "dev-editor": "pnpm --filter @silk-road-monopoly/map-editor run dev",
    "dev-admin": "pnpm --filter @silk-road-monopoly/admin run dev",
    "build-client:mac": "pnpm --filter @silk-road-monopoly/client run build -- --mac",
    "build-client:win": "pnpm --filter @silk-road-monopoly/client run build -- --win",
    "build-editor:mac": "pnpm --filter @silk-road-monopoly/map-editor run build -- --mac",
    "build-editor:win": "pnpm --filter @silk-road-monopoly/map-editor run build -- --win",
    "build-client": "pnpm --filter @silk-road-monopoly/client run build",
    "build-server": "pnpm --filter @silk-road-monopoly/server run build",
    "docker:up": "docker compose -f docker/docker-compose.yml up",
    "docker:build": "docker compose -f docker/docker-compose.yml build silkroad-server",
    "docker:export": "docker save silkroad-server | gzip > docker/dist/silkroad-server.tar.gz",
    "build-editor": "pnpm --filter @silk-road-monopoly/map-editor run build",
    "check-client": "pnpm --filter @silk-road-monopoly/client run check",
    "check-editor": "pnpm --filter @silk-road-monopoly/map-editor run check",
    "check-all": "pnpm --filter @silk-road-monopoly/client run check && pnpm --filter @silk-road-monopoly/map-editor run check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "monopoly",
    "maritime-silk-road",
    "silk-road",
    "game",
    "multiplayer",
    "webrtc",
    "vue",
    "typescript",
    "electron",
    "map-editor",
    "board-game",
    "p2p"
  ],
  "author": "Fat_Paper",
  "license": "GPL-3.0",
  "packageManager": "pnpm@10.10.0",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "6.4.2",
    "@fortawesome/free-solid-svg-icons": "6.4.2",
    "@fortawesome/vue-fontawesome": "3.0.3",
    "@monaco-editor/loader": "1.5.0",
    "ant-design-vue": "4.2.6",
    "axios": "1.11.0",
    "express": "4.18.2",
    "filtrex": "^3.1.0",
    "jsencrypt": "3.5.4",
    "jsep": "^1.4.0",
    "lodash": "4.17.21",
    "mitt": "3.0.1",
    "monaco-editor": "0.50.0",
    "pinia": "2.0.33",
    "pixi.js": "8.14.0",
    "protobufjs": "7.5.3",
    "three": "0.179.1",
    "vue": "3.5.18",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@types/express": "4.17.15",
    "@types/lodash": "4.17.21",
    "@types/node": "20.6.4",
    "@types/three": "0.179.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "cross-env": "10.0.0",
    "dts-bundle-generator": "9.5.1",
    "rollup-plugin-external-globals": "0.10.0",
    "rollup-plugin-visualizer": "5.12.0",
    "sass": "1.58.3",
    "terser": "^5.46.0",
    "typescript": "5.9.2",
    "unplugin-vue-components": "29.0.0",
    "vite": "^5.4.21",
    "vite-plugin-compression": "0.5.1",
    "vite-plugin-electron": "0.29.0",
    "vite-plugin-electron-renderer": "0.14.6",
    "vite-plugin-monaco-editor-esm": "2.0.2",
    "vite-plugin-static-copy": "3.1.1",
    "vue-tsc": "3.2.8",
    "prettier": "^3.5.0"
  }
}
