# 环境变量配置

```env
# ==================== 服务器配置 ====================
SERVER_PORT=8081
ICE_SERVER_PORT=8082
SILKROAD_ADMIN_PORT=8083

# ==================== 域名配置 ====================
PROTOCOL=http
SILKROAD_DOMAIN=localhost

# ==================== 数据库配置 ====================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=silkroad

# ==================== 路径前缀 ====================
API_BASE_PREFIX=/api
ADMIN_BASE_PREFIX=/admin

# ==================== TURN/STUN 配置 ====================
EXTERNAL_IP=127.0.0.1
TURN_SECRET=your_turn_secret_here
COTURN_CERTS_PATH=./docker/coturn/certs

# ==================== 腾讯云 COS ====================
COS_SECRET_ID=your_secret_id
COS_SECRET_KEY=your_secret_key
COS_BUCKET=silkroad-monopoly
COS_REGION=ap-guangzhou

# ==================== 地图加密 ====================
MAP_ENCRYPT_KEY=your_encrypt_key_here
```
